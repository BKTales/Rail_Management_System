CC = riscv32-linux-gcc
CFLAGS = -Wall -Wextra -fanalyzer -g
ARCHFLAGS = -march=rv32imd -mabi=ilp32d
LIBRV32 = ${HOME}/bin/bootlin/riscv32-buildroot-linux-gnu/sysroot

# Assembly files usados por todos os testes
ASM_FILES = asm.s trim.s to_upper_case.s string_compare.s comand_construction.s callfunc.S
ASM_OBJS  = $(ASM_FILES:.s=.o)
ASM_OBJS  := $(ASM_OBJS:.S=.o)

# Unity
UNITY_OBJ = ../../unity.o

# Lista de testes (cada teste tem seu próprio main)
TESTS = trim_test to_upper_case_test command_construction_test compare_string_test

# Alvos principais
all: $(TESTS:%=%.elf)

# Regra para compilar cada teste em seu próprio ELF
%.elf: %.c $(ASM_OBJS) $(UNITY_OBJ)
	$(CC) $(CFLAGS) $(ARCHFLAGS) $^ -o $@

# Compilar C
%.o: %.c
	$(CC) $(CFLAGS) $(ARCHFLAGS) -I. -c $< -o $@

# Compilar Assembly
%.o: %.s
	$(CC) $(CFLAGS) $(ARCHFLAGS) -c $< -o $@

%.o: %.S
	$(CC) $(CFLAGS) $(ARCHFLAGS) -c $< -o $@

# Executar todos os testes
run: all
	@for t in $(TESTS); do \
		echo "Running $$t..."; \
		qemu-riscv32 -L $(LIBRV32) ./$$t.elf; \
	done

# Limpeza
clean:
	rm -f *.o *.elf

full-clean: clean
	rm -f ../../unity.o
